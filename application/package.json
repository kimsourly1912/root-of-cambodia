{
  "name": "root-of-cambodia",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "build": "next build --webpack",
    "build:worker": "opennextjs-cloudflare build",
    "preview:worker": "wrangler dev --ip 127.0.0.1 --port 8787",
    "typecheck": "tsc --noEmit",
    "test:worker": "vitest run --project worker-http",
    "types:bindings": "wrangler types --env-interface CloudflareEnv",
    "test:backend": "vitest run --project backend",
    "init:local": "node scripts/init-local.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "better-auth": "1.7.14",
    "drizzle-orm": "0.45.4",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.9",
    "@opennextjs/cloudflare": "1.20.13",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "wrangler": "4.154.0"
  }
}
