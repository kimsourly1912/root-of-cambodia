{
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "name": "@root-of-cambodia/web",
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1 --port 8787",
    "build": "next build --webpack",
    "build:worker": "opennextjs-cloudflare build",
    "preview:worker": "wrangler dev --ip 127.0.0.1 --port 8787 --persist-to ../../.wrangler/state",
    "init:local": "node scripts/init-local.mjs",
    "types:bindings": "wrangler types --include-runtime=false --env-interface CloudflareEnv",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource/noto-sans-khmer": "5.3.0",
    "@root-of-cambodia/backend": "workspace:*",
    "@tailwindcss/postcss": "4.3.3",
    "@tanstack/react-form": "1.33.5",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cn": "0.5.0",
    "lucide-react": "1.64.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  }
}
