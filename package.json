{
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "name": "root-of-cambodia",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "init:local": "pnpm --filter @root-of-cambodia/web run init:local",
    "dev": "pnpm --filter @root-of-cambodia/web run dev",
    "build": "pnpm --filter @root-of-cambodia/web run build",
    "build:worker": "pnpm --filter @root-of-cambodia/web run build:worker",
    "build:jobs": "pnpm --filter @root-of-cambodia/jobs run build",
    "preview:worker": "pnpm --filter @root-of-cambodia/web run preview:worker",
    "preview:jobs": "pnpm --filter @root-of-cambodia/jobs run preview",
    "types:bindings": "pnpm --filter @root-of-cambodia/backend run types:runtime && pnpm --filter @root-of-cambodia/web run types:bindings && pnpm --filter @root-of-cambodia/jobs run types:bindings",
    "typecheck": "pnpm -r run typecheck && tsc --noEmit -p tests/tsconfig.json",
    "test:backend": "vitest run --project backend",
    "test:jobs": "vitest run --project backend packages/backend/src/features/jobs/tests/jobs.test.ts",
    "test:worker": "vitest run --project worker-http",
    "test": "vitest run",
    "test:browser": "playwright test",
    "reviewer:local": "node scripts/configure-reviewer-local.ts",
    "seed:local": "node --import tsx scripts/seed-local.ts"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.9",
    "@opennextjs/cloudflare": "1.20.13",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "wrangler": "4.154.0",
    "@root-of-cambodia/backend": "workspace:*",
    "better-auth": "1.7.14",
    "@playwright/test": "1.64.1"
  }
}
