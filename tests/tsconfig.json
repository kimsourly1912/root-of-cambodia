{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "types": [
      "node",
      "@cloudflare/vitest-plugin/types"
    ]
  },
  "include": [
    "**/*.ts",
    "../packages/backend/src/**/tests/**/*.ts",
    "../packages/backend/src/testing/**/*.ts",
    "../packages/backend/tests/**/*.ts",
    "../apps/web/worker-configuration.d.ts",
    "../apps/jobs/worker-configuration.d.ts",
    "../packages/backend/worker-configuration.d.ts",
    "../vitest*.ts",
    "../playwright.config.ts",
    "../scripts/configure-reviewer-local.ts",
    "../scripts/configure-booking-terms-local.ts",
    "../scripts/staging-fixtures.ts",
    "../scripts/seed-staging.ts",
    "../scripts/seed-local.ts"
  ]
}
